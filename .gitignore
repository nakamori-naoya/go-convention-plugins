# OS and language-generated files
.DS_Store
__pycache__/
*.py[cod]

# Repository-root allowlist
# A new top-level path is ignored until it is explicitly approved here.
/*
!/.agents/
!/.claude-plugin/
!/.github/
!/plugins/
!/scripts/
!/tests/
!/decisions/
!/AGENTS.md
!/CLAUDE.md
!/LICENSE
!/README.md
!/SECURITY.md
!/VALIDATION.md
!/.gitignore
!/evals/

# claude plugin eval の実行結果
/evals/results/

# 評価用ディレクトリは配置階層を問わずローカルに保持する
evals/
